            </div>
          </div>
        </div>
        <div class="ticket-section">${ticketsHTML}</div>
        <div class="card-footer">
          ${priceHTML}
          <div class="ticket-links">${linksHTML || '<span style="font-size:12px;color:var(--text-muted)">購入リンク未設定</span>'}</div>
        </div>
      </div>`;
  }

  // ────────────────────────────────────────────────
  //  フィルタリング + 遅延ロード
  // ────────────────────────────────────────────────
  let activeGenre  = "all";
  let activeStatus = "all";
  let activeRegion = "all";
  let searchQuery  = "";

  const BATCH_SIZE = 24;
  let filteredEvents = [];
  let renderedCount = 0;

  function ticketKind(t) {
    if (t.soldout) return null;
    if (saleStartPending(t)) {
      const d = daysFrom(t.startDate);
      return d <= 7 ? "urgent" : d <= 31 ? "soon" : "normal";
    }
    if (t.startDate && parseDateStr(t.date) >= today) {
      return "selling";
    }
    if (!t.startDate && parseDateStr(t.date) >= today) {
      const d = daysFrom(t.date);
      return d <= 7 ? "urgent" : d <= 31 ? "soon" : "normal";
    }
    return null;
  }

  function computeCardStatus(ev) {
    const kinds = (ev.tickets || []).map(ticketKind).filter(Boolean);
    for (const p of ["urgent", "soon", "selling", "normal"]) {
      if (kinds.includes(p)) return p;
    }
    return "passed";
  }

  // 発売フィルタ(今週発売/今月発売/先行受付前)専用の判定。
  // ★発売前(発売開始日=startDateが未来)のチケットだけを対象にする。
  // 販売中(発売済で終了日が近い＝締切間近)は「発売」ではないので対象外＝nullを返す。
  function releaseKind(t) {
    if (t.soldout) return null;
    if (saleStartPending(t)) {
      const d = daysFrom(t.startDate);
      return d <= 7 ? "urgent" : d <= 31 ? "soon" : "normal";
    }
    return null;
  }
  function eventReleaseStatus(ev) {
    const kinds = (ev.tickets || []).map(releaseKind).filter(Boolean);
    for (const p of ["urgent", "soon", "normal"]) {
      if (kinds.includes(p)) return p;
    }
    return null;
  }

  // ジャンルの大分類（フィルターの折りたたみ用・2026-08-13）。
  // ★ボタンが無いジャンル(musical)もここに入れる＝「舞台すべて」で拾えるようにするため。
  const GENRE_GROUPS = {
    music:   ["jpop","classic","rock","jazz","enka","yougaku","anime","idol","kpop","hiphop","chanson","musicetc"],
    stage:   ["engeki","musical","dento","seiyuu","2.5ji"],
    ento:    ["owarai","kaidan","dinnershow","aisatsu","youtuber","vtuber","fanevent"],
    odekake: ["sports","art","kids","fes","hanabi","gourmet"]
  };

  function eventGenres(ev) {
    return [ev.genre].concat(ev.extraGenres || []).filter(Boolean);
  }

  function matchEvent(ev) {
    if (ev.verified !== true) return false;
    const grp = activeGenre.startsWith("g:") ? GENRE_GROUPS[activeGenre.slice(2)] : null;
    const matchGenre  = activeGenre  === "all"
      || (grp ? eventGenres(ev).some(g => grp.includes(g)) : false)
      || (!grp && ev.genre === activeGenre)
      || (!grp && (ev.extraGenres || []).includes(activeGenre))
      || (activeGenre === "engeki" && (ev.genre === "2.5ji" || ev.genre === "seiyuu" || ev.genre === "musical"))
      || (activeGenre === "anime"  && ev.genre === "seiyuu");
    const rel = eventReleaseStatus(ev);   // 発売フィルタは発売前(発売開始日が未来)のチケットだけで判定
    const matchStatus = activeStatus === "all"
      || (activeStatus === "urgent"   && rel === "urgent")
      || (activeStatus === "soon"     && (rel === "urgent" || rel === "soon"))
      || (activeStatus === "upcoming" && rel === "normal");
    const haystack = (ev.artist + " " + ev.name).toLowerCase();
    const matchSearch = searchQuery === "" || haystack.includes(searchQuery.toLowerCase());
    const matchRegion = activeRegion === "all"
      || (activeRegion === "zenkoku"
            ? ev.prefecture === "全国"
            : eventRegions(ev).has(activeRegion));
    return matchGenre && matchStatus && matchSearch && matchRegion;
  }

  function renderNextBatch() {
    if (renderedCount >= filteredEvents.length) return;
    const list = document.getElementById("eventList");
    const end = Math.min(renderedCount + BATCH_SIZE, filteredEvents.length);
    const html = filteredEvents.slice(renderedCount, end).map(renderCard).join("");
    list.insertAdjacentHTML("beforeend", html);
    renderedCount = end;
  }

  // 新着タブの並び順を固定する番号リスト（今の日付順を焼き付け。チケットを編集しても並びが動かない）
  // ※新着を追加したら末尾にidを足せば固定される（足さないとそのカードは一番下に並ぶ）
  // 2026-05-27: ⚠️相談2件(278最後の事件/285StrayKidsVR)を先頭。残り13件はid昇順(投入順)。
  // 2026-05-30: MeseMoa.47ツアー(id77)を新着に掲載。続けてぴあ新着55件(id315-370,331欠番)を投入順(id昇順)で固定。
  const NEW_ORDER = [4792, 4793, 4794, 4795, 4796, 4797, 4798, 4799, 4800, 4801, 4802, 4803, 4804, 4805, 4806, 4807, 4808, 4809, 4810, 4811, 4812, 4813, 4814, 4815, 4816, 4817, 4818, 4819, 4820, 4821, 4822, 4823, 4824, 4825, 4826, 4827, 4828, 4829, 4830, 4831, 4832, 4833, 4834, 4835, 4836, 4837, 4838, 4839, 4840, 4841, 4842, 4843, 4844, 4845, 4846, 4847, 4848, 4849, 4850, 4851, 4852, 4853, 4854, 4855, 4856, 4857, 4858, 4859, 4860, 4861, 4862, 4863, 4864, 4865, 4866, 4867, 4868, 4869, 4870, 4871, 4872, 4873, 4874, 4875, 4876, 4877, 4878, 4879, 4880, 4881, 4882, 4883, 4884, 4885, 4886, 4887, 4888, 4889, 4890, 4891, 4893, 4894, 4895, 4898, 4899, 4900, 4901, 4902, 4903, 4904, 4905, 4906, 4907, 4908, 4909, 4910, 4911, 4912, 4913, 4914, 4915, 4916, 4917, 4918, 4919, 4920, 4921, 4922, 4923, 4924, 4925, 4926, 4927, 4928, 4929, 4930, 4931, 4932, 4933, 4934, 4935, 4936, 4937, 4938, 4939, 4940, 4941];

  function applyFilters() {
    filteredEvents = EVENTS.filter(matchEvent);
    // 新着タブは NEW_ORDER の番号順で固定し、日付順での並び替えを止める
    if (activeGenre === "new") {
      filteredEvents.sort((a, b) => {
        const ia = NEW_ORDER.indexOf(a.id); const ib = NEW_ORDER.indexOf(b.id);
        return (ia < 0 ? 9999 : ia) - (ib < 0 ? 9999 : ib);
      });
    }
    renderedCount = 0;
    document.getElementById("eventList").innerHTML = "";
    document.getElementById("resultCount").textContent = filteredEvents.length;
    document.getElementById("emptyState").style.display = filteredEvents.length === 0 ? "block" : "none";
    renderNextBatch();
  }

  // ────────────────────────────────────────────────
  //  初期化
  // ────────────────────────────────────────────────
  function init() {
    const list = document.getElementById("eventList");

    filteredEvents = EVENTS.filter(e => e.verified === true);
    renderedCount = 0;
    list.innerHTML = "";
    renderNextBatch();

    document.getElementById("resultCount").textContent = filteredEvents.length;

    const sentinel = document.createElement("div");
    sentinel.id = "loadSentinel";
    sentinel.style.height = "1px";
    list.parentNode.insertBefore(sentinel, list.nextSibling);

    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) renderNextBatch();
      });
    }, { rootMargin: "800px" });
    io.observe(sentinel);

    // ジャンルフィルター
    document.querySelectorAll(".filter-btn[data-genre]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn[data-genre]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeGenre = btn.dataset.genre;
        applyFilters();
        // ジャンルを押したら「件数の行が見えるところまで」だけ動かす（ユーザー指示 2026-08-10）。
        // ボタンが27個あって「本当に切り替わったか」が分からず何度も押してしまう、が理由。
        // 🚨結果の先頭を上端に固定する版は「動かしすぎ」で差し戻された＝最小限だけ動かす。
        revealResultCount();
      });
    });

    // ジャンルグループの開閉（見出しはフィルターボタンではないので .genre-group-toggle で拾う）
    document.querySelectorAll(".genre-group").forEach(grp => {
      const key = grp.dataset.group;
      const list = GENRE_GROUPS[key] || [];
      const n = EVENTS.filter(e => e.verified === true && eventGenres(e).some(g => list.includes(g))).length;
      const cnt = grp.querySelector(".gg-count");
      if (cnt) cnt.textContent = "(" + n.toLocaleString() + ")";
      grp.querySelector(".genre-group-toggle").addEventListener("click", () => {
        const wasOpen = grp.classList.contains("open");
        // 一度に開くのは1グループだけ（27個が一気に出ると畳んだ意味がない）
        document.querySelectorAll(".genre-group.open").forEach(g => g.classList.remove("open"));
        if (!wasOpen) grp.classList.add("open");
      });
    });

    // ステータスフィルター
    document.querySelectorAll(".filter-btn[data-status]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn[data-status]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeStatus = btn.dataset.status;
        applyFilters();
        // ステータスもジャンル・エリアと同じだけ動かす（ユーザー指示 2026-08-20「全部よ」）。
        // 押しても画面が動かないと切り替わったか分からない、はどのフィルターでも同じ。
        revealResultCount();
      });
    });

    // 地方フィルター
    document.querySelectorAll("[data-region]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll("[data-region]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeRegion = btn.dataset.region;
        applyFilters();
        // エリアもジャンルと同じだけ動かす（ユーザー指示 2026-08-20）。
        // 地方ボタンは9個あって、押しても画面が動かないと切り替わったか分からない＝ジャンルと同じ理由。
        revealResultCount();
      });
    });

    // 検索 & サジェスト
    const searchInput = document.getElementById("searchInput");
    const suggest = document.getElementById("searchSuggest");

    const allLabels = [...new Set(EVENTS.filter(e => e.verified === true).map(ev => ev.artist))];

    // 【検索したら結果まで自動スクロール】(ユーザー指示 2026-08-04)
    // 検索窓の下にジャンル/ステータス/地方のボタンが縦に長く並ぶので、検索しても
    // 結果が画面の外にいて「下にスクロールしないと確認できない」状態だった。
    // 🚨打っている途中では動かさない（ユーザー 2026-08-04「早いよ」）。
    // 動くのは「Enterを押した時」と「サジェスト候補を選んだ時」の2つだけ。
    let scrollTimer = null;
    function scrollToResults(delay) {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const meta = document.querySelector(".result-meta");
        if (!meta) return;
        const top = meta.getBoundingClientRect().top + window.pageYOffset - 8;
        window.scrollTo({ top: top, behavior: "smooth" });
      }, delay);
    }
    // 【ジャンル切替え用】件数の行（"◯◯件のイベント"）を画面の上のほうへ出す。
    // ユーザーが実物の画面で指した位置＝追従ヘッダーのすぐ下に件数、その下に1枚目のカードが丸ごと見える形
    // （2026-08-10。最初「結果の先頭を上端へ」で"動かしすぎ"、次に"件数が見えるところまで"で足りず、この位置に着地）。
    // header は position:sticky（56〜64px）なので、その実寸を測って隠れないように差し引く。
    function revealResultCount() {
      clearTimeout(scrollTimer);
      const meta = document.querySelector(".result-meta");
      if (!meta) return;
      const hd = document.querySelector("header");
      const gap = (hd ? hd.getBoundingClientRect().height : 0) + 80;
      const target = meta.getBoundingClientRect().top + window.pageYOffset - gap;
      window.scrollTo({ top: Math.max(0, target), behavior: "smooth" });
    }

    function showSuggest(query) {
      if (!query) { suggest.classList.remove("open"); return; }
      const q = query.toLowerCase();
      const matches = allLabels.filter(label => label.toLowerCase().includes(q)).slice(0, 10);
      if (matches.length === 0) { suggest.classList.remove("open"); return; }
      suggest.innerHTML = matches.map(label =>
        `<div class="suggest-item">${label}</div>`
      ).join("");
      suggest.classList.add("open");
      suggest.querySelectorAll(".suggest-item").forEach(item => {
        item.addEventListener("mousedown", () => {
          searchInput.value = item.textContent;
          searchQuery = item.textContent.trim();
          if (isNarrowed()) clearNarrowing();   // 候補を選んだ時も絞り込みを外す
          applyFilters();
          suggest.classList.remove("open");
          scrollToResults(0);
        });
      });
    }

    // 🚨【2026-08-20 ユーザー指示】名前で検索したら、ジャンル・エリア・ステータスの絞り込みを解除する。
    //   理由＝エリアで「関東」等を押したまま名前を検索すると、その地方の公演しか出ず
    //   「載っているのに出てこない」状態になる（シルク・ドゥ・ソレイユで実際に起きた）。
    //   ボタンの見た目も「すべて」に戻す＝画面と結果を食い違わせない。
    function clearNarrowing() {
      activeGenre = "all"; activeStatus = "all"; activeRegion = "all";
      document.querySelectorAll(".filter-btn[data-genre]").forEach(b =>
        b.classList.toggle("active", b.dataset.genre === "all"));
      document.querySelectorAll(".filter-btn[data-status]").forEach(b =>
        b.classList.toggle("active", b.dataset.status === "all"));
      document.querySelectorAll("[data-region]").forEach(b =>
        b.classList.toggle("active", b.dataset.region === "all"));
    }
    function isNarrowed() {
      return activeGenre !== "all" || activeStatus !== "all" || activeRegion !== "all";
    }

    searchInput.addEventListener("input", e => {
      const q = e.target.value.trim();
      if (q && isNarrowed()) clearNarrowing();   // 検索を始めたら絞り込みを外す
      searchQuery = q;
      applyFilters();
      showSuggest(searchQuery);
    });

    // Enterは待たずにすぐ結果へ（サジェストは閉じる）
    searchInput.addEventListener("keydown", e => {
      if (e.key === "Enter") {
        suggest.classList.remove("open");
        if (searchQuery) scrollToResults(0);
      }
    });

    searchInput.addEventListener("blur", () => {
      setTimeout(() => suggest.classList.remove("open"), 150);
    });

    // 【今週のピックアップ】記事の中の「発売になる公演」やアーティスト名を押したら、
    // その名前で検索した状態にして結果まで動かす（2026-08-20 ユーザー指示）。
    // カードは無限スクロールで後から描画されるので、アンカーではなく検索で確実に出す。
    // 【今週のピックアップ】締めの一文を押したら STATUS「今週発売」で絞って結果まで動かす
    // 【今週のピックアップ】主役は1組ずつ開く（ユーザー指示 2026-08-20「さらにおりたためない？」）
    document.querySelectorAll(".pk-open").forEach(btn => {
      btn.addEventListener("click", () => {
        const d = btn.nextElementSibling;
        const open = btn.getAttribute("aria-expanded") === "true";
        d.hidden = open;
        btn.setAttribute("aria-expanded", String(!open));
      });
    });

    document.querySelectorAll("[data-pk-status]").forEach(el => {
      el.addEventListener("click", ev => {
        ev.preventDefault();
        const s = el.dataset.pkStatus;
        searchInput.value = ""; searchQuery = "";
        activeGenre = "all"; activeRegion = "all"; activeStatus = s;
        document.querySelectorAll(".filter-btn[data-genre]").forEach(b =>
          b.classList.toggle("active", b.dataset.genre === "all"));
        document.querySelectorAll("[data-region]").forEach(b =>
          b.classList.toggle("active", b.dataset.region === "all"));
        document.querySelectorAll(".filter-btn[data-status]").forEach(b =>
          b.classList.toggle("active", b.dataset.status === s));
        applyFilters();
        scrollToResults(0);
      });
    });

    document.querySelectorAll("[data-pk-search]").forEach(el => {
      el.addEventListener("click", ev => {
        ev.preventDefault();
        const q = el.dataset.pkSearch;
        searchInput.value = q;
        searchQuery = q;
        if (isNarrowed()) clearNarrowing();
        applyFilters();
        suggest.classList.remove("open");
        scrollToResults(0);
      });
    });
  }

  // 【現行ルール】並び順（ユーザー指示 2026-07-10）＝日付を1本の時間軸にして早い順。
  //   同じ日付なら「発売開始(発売前)」が上、「締切(販売中)」が下。
  //     7/11 発売開始 Kroi ／ 7/11 発売開始 羊文学 ／ 7/11 締切 ○○ ／ 7/12 発売開始 □□ …
  //   売切・終了だけのカードは末尾。
  //   ※2026-07-03 の「販売中を先頭」ルールを上書き。カウントダウン(発売までの日数)を主役にするため、
  //     締切が先の販売中カードより発売日が近い発売前カードが上に来る（旧「にじクラ問題」は許容）。
  const SORT_PRESALE = 0, SORT_SELLING = 1;   // 同日内の優先度
  EVENTS.sort((a, b) => {
    const classify = (ev) => {
      const cands = [];                                // [日付, 種別]
      for (const t of (ev.tickets || [])) {
        if (t.soldout) continue;
        if (t.saleUntilSoldOut) {                      // 予定枚数まで販売中＝今買える
          if (parseDateStr(t.date) >= today) cands.push([t.date, SORT_SELLING]);
          continue;
        }
        if (saleStartPending(t)) {                     // 発売前（発売日が未来／今日の発売時刻前）
          cands.push([t.startDate, SORT_PRESALE]);
          continue;
        }
        // 【本日発売は一日中いちばん上】（ユーザー 2026-07-19「本日発売は一日中上に置くのは当然でしょ」）
        // 今日が発売日の枠は、発売時刻(10:00等)を過ぎても「7/19の発売開始」として扱う。
        // これが無いと10時を境に締切日(何ヶ月も先)へキーが飛び、本日発売カードが画面の下に沈む。
        if (t.startDate === todayStr) {
          cands.push([t.startDate, SORT_PRESALE]);
          continue;
        }
        if (parseDateStr(t.date) >= today) cands.push([t.date, SORT_SELLING]);  // 販売中（締切未到来）
      }
      if (!cands.length) return { rank: 2, key: ev.date, kind: SORT_SELLING };  // 売切/終了は末尾
      cands.sort((x, y) => (x[0] !== y[0] ? (x[0] < y[0] ? -1 : 1) : x[1] - y[1]));
      return { rank: 0, key: cands[0][0], kind: cands[0][1] };
    };
    const ca = classify(a), cb = classify(b);
    if (ca.rank !== cb.rank) return ca.rank - cb.rank;   // 買える/これから → 終了
    if (ca.key !== cb.key)   return ca.key < cb.key ? -1 : 1;   // 日付が早い順
    if (ca.kind !== cb.kind) return ca.kind - cb.kind;   // 同日は 発売開始 → 締切
    // 【X紹介済みを同じ塊の先頭へ】（ユーザー指示 2026-08-01「並び順変えて頂戴」）
    //   ev.xPost = X(旧Twitter)で紹介した日 "YYYY-MM-DD"。
    //   日付の時間軸も「発売開始→締切」も一切崩さない。上の3段が同点のときだけ効く同点決着で、
    //   紹介済み（新しい投稿ほど上）を先に出す。印が古くなれば自然に順位が下がる。
    const xa = a.xPost || "", xb = b.xPost || "";
    if (xa !== xb) return xa < xb ? 1 : -1;
    return (a.id || 0) - (b.id || 0);
  });

  init();

  const pagetop = document.getElementById("pagetop");
  window.addEventListener("scroll", () => {
    pagetop.classList.toggle("visible", window.scrollY > 300);
  });
  pagetop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  // 【今週のピックアップ】つづきを読む＝同じページで開く（2026-08-20 ユーザー指示）。
  // 🚨開いたら閉じられること（ユーザー「続きを読むを戻す折りたたむ矢印もひつようよね」）。
  //   閉じた時は記事の頭に戻す＝本文が長いと、閉じたあとどこにいるか分からなくなるため。
  (function () {
    const btn = document.getElementById("pickupMore");
    const body = document.getElementById("pickupBody");
    const sec = document.getElementById("pickup");
    if (!btn || !body) return;
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      body.hidden = open;
      btn.setAttribute("aria-expanded", String(!open));
      btn.textContent = open ? "つづきを読む" : "折りたたむ";
      if (open && sec) {
        const hd = document.querySelector("header");
        const gap = (hd ? hd.getBoundingClientRect().height : 0) + 12;
        const top = sec.getBoundingClientRect().top + window.pageYOffset - gap;
        window.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
      }
    });
  })();

  // 固定バナー 閉じるボタン
  (function() {
    const banner = document.getElementById('fixedBanner');
    const closeBtn = document.getElementById('fixedBannerClose');
    if (!banner || !closeBtn) return;
    if (sessionStorage.getItem('trivagoBannerClosed') === '1') {
      banner.style.display = 'none';
      document.body.style.paddingBottom = '0';
    }
    closeBtn.addEventListener('click', () => {
      banner.style.display = 'none';
      document.body.style.paddingBottom = '0';
      sessionStorage.setItem('trivagoBannerClosed', '1');
    });
  })();

</script>
