  // データの prefecture / 会場・公演名は短縮形（「東京」「大阪」）なので短縮名をキーにする
  const PREFECTURE_TO_REGION = {
    "北海道": "hokkaido",
    "青森": "tohoku", "岩手": "tohoku", "宮城": "tohoku",
    "秋田": "tohoku", "山形": "tohoku", "福島": "tohoku",
    "茨城": "kanto",  "栃木": "kanto",  "群馬": "kanto",
    "埼玉": "kanto",  "千葉": "kanto",  "東京": "kanto",  "神奈川": "kanto",
    "新潟": "chubu",  "富山": "chubu",  "石川": "chubu",  "福井": "chubu",
    "山梨": "chubu",  "長野": "chubu",  "岐阜": "chubu",  "静岡": "chubu",  "愛知": "chubu",
    "三重": "kinki",  "滋賀": "kinki",  "京都": "kinki",  "大阪": "kinki",
    "兵庫": "kinki",  "奈良": "kinki",  "和歌山": "kinki",
    "鳥取": "chugoku","島根": "chugoku","岡山": "chugoku","広島": "chugoku","山口": "chugoku",
    "徳島": "shikoku","香川": "shikoku","愛媛": "shikoku","高知": "shikoku",
    "福岡": "kyushu", "佐賀": "kyushu", "長崎": "kyushu", "熊本": "kyushu",
    "大分": "kyushu", "宮崎": "kyushu", "鹿児島": "kyushu","沖縄": "kyushu",
    // 海外公演（ぴあが日本の県を持たない興行）。バッジの「（台湾 M/D公演）」から拾う
    "台湾": "kaigai",
  };
  const PREF_LIST = Object.keys(PREFECTURE_TO_REGION);
  // 県名→地域（フルネーム「東京都」等が来ても末尾の都府県を外して照合）
  function prefToRegion(p) {
    if (!p) return null;
    return PREFECTURE_TO_REGION[p] || PREFECTURE_TO_REGION[p.replace(/[都府県]$/, "")] || null;
  }
  // そのエントリが実際に公演を持つ地域の集合を返す。
  // prefecture が「全国」のツアーは会場・dateLabel・チケット種別から実際の県名を拾って判定する（嘘の地域カウントを防ぐ）
  // 期限切れ枠は地域判定から除外（買えない公演で地域カウントを水増ししない）
  function isTicketActive(t) {
    if (t.saleUntilSoldOut) return true;
    if ((!t.startDate || parseDateStr(t.startDate) <= today) && parseDateStr(t.date) < today) return false;
    return true;
  }
  function eventRegions(ev) {
    const set = new Set();
    // まず「まだ買える」枠の種別から県名を拾う（複数公演で一部だけ期限切れ／別県の場合に正確）。
    // prefecture が複合（「宮城/広島/新潟」等）でも、期限切れ公演の県はここで除外される。
    let text = (ev.tickets || []).filter(isTicketActive).map(t => t.type || "").join(" ");
    if (!PREF_LIST.some(p => text.includes(p))) {
      // アクティブ枠に県名が無い場合のフォールバック
      if (ev.prefecture && ev.prefecture !== "全国") {
        text = ev.prefecture;                                  // 単独公演など
      } else {
        text = (ev.venue || "") + " " + (ev.dateLabel || "");  // 全国かつ枠に県名なし
      }
    }
    const scan = text.replace(/東京/g, "東京_"); // 「京都」が「東京都」に誤マッチしないよう分離
    PREF_LIST.forEach(p => {
      const hay = (p === "京都") ? scan : text;
      if (hay.includes(p)) set.add(PREFECTURE_TO_REGION[p]);
    });
    return set;
  }
  // 1チケット（販売枠）が属する地域。種別名「（北海道・真駒内 6/20公演）」等から県名を拾う。
  // 県名が無い枠（単独公演で種別に県名なし）はエントリ全体の地域にフォールバック。
  function ticketRegions(t, ev) {
    const txt = t.type || "";
    const scan = txt.replace(/東京/g, "東京_");
    const set = new Set();
    PREF_LIST.forEach(p => {
      const hay = (p === "京都") ? scan : txt;
      if (hay.includes(p)) set.add(PREFECTURE_TO_REGION[p]);
    });
    if (set.size === 0) eventRegions(ev).forEach(r => set.add(r));
    return set;
  }

  // ────────────────────────────────────────────────
  //  カード生成
  // ────────────────────────────────────────────────
  // チケット種別の「（…公演）」カッコ内の公演日(M/D)だけをオレンジ強調する
  // （販売日・締切日など公演日以外の日付は対象外）
  function highlightShowDate(s) {
    if (!s) return s;
    // バッジ内の公演日(M/D・M/D-D)を全てオレンジ強調する。カッコの有無・全角半角・〔〕角括弧を問わず拾う。
    // 日付の直前に年表記(R9年 / 2027年 等)が付く場合は年ごとオレンジに含める。
    // ただし日付の直後に「発売/受付/販売/締切」が来るもの(=販売日)は強調しない。
    s = s.replace(/((?:R\d{1,2}年\s*|20\d\d年\s*)?\d{1,2}\/\d{1,2}(?:-\d{1,2})?)(?!\s*(?:\d{1,2}:\d{2}\s*)?(?:発売|受付|販売|締切))/g, '<span class="show-date">$1</span>');
    return s;
  }
  // 複数県(2県以上が・で連なる)の県名リストを小さい字で表示する（全県載せても長くなりすぎないように）
  var _PREFS_RE = "北海道|青森|岩手|宮城|秋田|山形|福島|茨城|栃木|群馬|埼玉|千葉|東京|神奈川|新潟|富山|石川|福井|山梨|長野|岐阜|静岡|愛知|三重|滋賀|京都|大阪|兵庫|奈良|和歌山|鳥取|島根|岡山|広島|山口|徳島|香川|愛媛|高知|福岡|佐賀|長崎|熊本|大分|宮崎|鹿児島|沖縄";
  function shrinkPrefList(s) {
    if (!s) return s;
    var re = new RegExp("((?:" + _PREFS_RE + ")(?:・(?:" + _PREFS_RE + "))+)", "g");
