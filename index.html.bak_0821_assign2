  // ────────────────────────────────────────────────
  //  ユーティリティ
  // ────────────────────────────────────────────────
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const now = new Date();   // 実際の現在時刻（発売時刻判定用）
  // 今日の日付文字列。toISOString はUTCに変換されて日付がずれるのでローカルで組む
  const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;

  function parseDateStr(str) {
    const [y, m, d] = str.split("-").map(Number);
    return new Date(y, m - 1, d);
  }

  function daysFrom(dateStr) {
    const d = parseDateStr(dateStr);
    return Math.round((d - today) / 86400000);
  }

  // 発売前チケットの「発売開始日時」がまだ来ていないか（当日は type 内の発売時刻を加味）。
  // 例: startDate=今日・type「… 7/4 10:00発売」→ 10:00 までは発売前、10:00 以降は販売中扱い。
  // 発売日が未来=常に発売前 / 発売日が過去=常に発売済 / 当日かつ時刻不明=従来通り0:00基準で販売中。
  function saleStartPending(t) {
    if (!t.startDate) return false;
    const sd = parseDateStr(t.startDate);
    if (sd > today) return true;
    if (sd < today) return false;
    // 時刻は「10:00発売」形＝発売時刻のときだけ見る。締切形「〜9/4 23:59」の 23:59 を
    // 発売時刻と読むと、今日発売済みの枠が一日中「発売前」に居座る（2026-07-14 修正）。
    const m = (t.type || "").match(/(\d{1,2}):(\d{2})\s*(?:発売|販売開始|受付開始)/);
    if (!m) return false;
    const start = new Date(sd);
    start.setHours(+m[1], +m[2], 0, 0);
    return now < start;
  }

  function getTicketStatus(dateStr) {
    const diff = daysFrom(dateStr);
    if (diff < 0)  return "passed";
    if (diff <= 7) return "urgent";
    if (diff <= 31) return "soon";
    return "normal";
  }

  function countdownLabel(dateStr) {
    const diff = daysFrom(dateStr);
    if (diff < 0)  return "終了";
    if (diff === 0) return "本日";
    if (diff === 1) return "明日";
    return `あと ${diff} 日`;
  }

  function formatDate(dateStr) {
    const d = parseDateStr(dateStr);
    return `${d.getMonth() + 1}/${d.getDate()}`;
  }

  const WEEK_DAYS = ['日','月','火','水','木','金','土'];
  function formatFullDate(dateStr) {
    if (!dateStr) return '';
    const d = parseDateStr(dateStr);
    return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日(${WEEK_DAYS[d.getDay()]})`;
  }

  const GENRE_LABEL = {
