      ? `<a class="ticket-link-btn btn-amazon" href="${genreAmazon.url}" target="_blank" rel="noopener">🛍 ${genreAmazon.label}</a>`
      : '';
    // 楽天 or ぴあが登録されていれば e+/ローチケは非表示（アフィリ優先）
    const hasPrimaryVendor = ev.links && (ev.links.rakuten || ev.links.pia);
    // 各バッジ(ticket)が別URLに飛ぶ統合エントリ(公演ごとにURLが違う)は、
