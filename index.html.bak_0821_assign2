      const datePrefix = (status === "selling" || (label === "本日発売" && displayDate === t.date)) ? "〜" : "";
      const timeHTML = dispTime ? ` <span class="ticket-date-time">${dispTime}</span>` : "";
      const dateLine = t.saleUntilSoldOut
        ? `<div class="ticket-date ticket-date-soldout-note">予定枚数に達し次第終了</div>`
        : `<div class="ticket-date">${datePrefix}${formatDate(displayDate)}${timeHTML}</div>`;
