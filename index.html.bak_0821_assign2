    ];
    // ホテル予約: Expedia（バリューコマース sid=3769972 / pid=892633446・報酬4.4%）。2026-06-13 楽天トラベル・trivagoから差し替え
    const HOTEL_EXPEDIA_BTN = `<a class="ticket-link-btn btn-hotel" href="https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3769972&pid=892633446" target="_blank" rel="nofollow noopener">🏨 会場近くのホテルを探す</a>`;
    const hotelBtn = HOTEL_EXPEDIA_BTN;
    const CONCERT_AMAZON = { url: "https://amzn.to/3OnUo4K", label: "コンサートアイテム" };
    const PENLIGHT_AMAZON = { url: "https://amzn.to/4trBSqX", label: "コンサートグッズ" };
    const ROCK_AMAZON = { url: "https://amzn.to/48LOZM1", label: "ライブ用耳栓" };
    const OWARAI_AMAZON = { url: "https://amzn.to/42i7Yu5", label: "お笑いグッズ" };
    const KIDS_AMAZON = { url: "https://amzn.to/49jivJa", label: "知育玩具" };
    const BASEBALL_AMAZON = { url: "https://amzn.to/4cjW1IR", label: "観戦便利アイテム" };
