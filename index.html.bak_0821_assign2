  }
  function renderCard(ev) {
    // 特定地域フィルター中は、その地域の公演バッジだけ表示（「すべて」「全国」選択時は全バッジ）
    let shownTickets = ev.tickets;
    if (activeRegion && activeRegion !== "all" && activeRegion !== "zenkoku") {
      const f = ev.tickets.filter(t => ticketRegions(t, ev).has(activeRegion));
      if (f.length) shownTickets = f;
    }
    // カード内の枠順も グローバルのカード順(2026-07-10)と同じ「1本の時間軸で早い順」に揃える＝
    // 発売前は発売日・販売中は締切を軸にして日付が早い順、同日なら発売前(これから発売)が上・締切(販売中)が下。
    // 終了はその下、売切は最下。
    // 旧(2026-07-03)は「販売中を全部上→発売前を下にまとめる」だったため、カウントダウン対象の発売前枠が
    // カード後方に沈んでいた（ユーザー指摘 2026-07-12「これから発売するのを後ろにまとめるな・日付順に」）。
    const ticketSortKey = (t) => {
      if (t.soldout) return [3, "9999-99-99", 1];              // 売切=最下
      if (t.saleUntilSoldOut) return [0, t.date, 1];           // 販売中（締切軸）
      if (saleStartPending(t)) return [0, t.startDate, 0];     // 発売前（発売日軸・同日で上）
      if (parseDateStr(t.date) >= today) return [0, t.date, 1];// 販売中（締切未到来）
      return [2, t.date, 1];                                    // 終了
    };
    shownTickets = shownTickets.slice().sort((a, b) => {
      const ka = ticketSortKey(a), kb = ticketSortKey(b);
      if (ka[0] !== kb[0]) return ka[0] - kb[0];               // 買える/これから → 終了 → 売切
      if (ka[1] !== kb[1]) return ka[1] < kb[1] ? -1 : 1;      // 日付が早い順（発売日/締切の時間軸）
      return ka[2] - kb[2];                                     // 同日は 発売前 → 販売中
    });
    const ticketsHTML = shownTickets.map(t => {
      // バッジからは末尾の締切/発売日時を外す（公演日や（）内の日付・範囲は残す）。
      // 日付＋時刻は下の色付き日付にまとめて表示する（時刻は dispTime）。
      const rawType = t.type || '';
      const badgeType = (rawType
        .replace(/\s*〜\s*\d{1,2}\/\d{1,2}(?:\s*\d{1,2}:\d{2})?\s*$/, '')
        .replace(/\s*\d{1,2}\/\d{1,2}(?:\s*\d{1,2}:\d{2})?\s*(?:発売開始|発売予定|発売|販売開始|受付開始|受付)\s*$/, '')
        .trim()) || rawType;
      // 発売/締切の時刻だけを拾う（（…公演）内の開演時刻を発売時刻と誤読しないよう、最後の閉じ括弧より後ろで探す）
      const _tm = rawType.replace(/^.*[）)]/, '').match(/\d{1,2}:\d{2}/);
      const dispTime = _tm ? _tm[0] : null;
      // 【予定枚数終了は消さずに残す】（ユーザー方針 2026-08-09）
      //   ぴあ等が「予定枚数終了」と出している間は OSHINAVI にも出しておく。URLも生かしたまま。
      //   Why: 売り切れた瞬間に消すと「売り切れた」のか「最初から載っていなかった」のかが
      //        見た人に区別できない＝サイトを信用できなくなる（ユーザーが大相撲九月場所で実感）。
      //   ぴあが枠ごと下げたら朝のルーチンで soldout が外れて削除候補に回る。
      //   安全弁＝公演日を過ぎたら出さない（ぴあがページを残し続けても永久に居座らせない）。
      if (t.soldout) {
        if (parseDateStr(ev.date) < today) return "";
        return `
          <div class="ticket-item soldout">
