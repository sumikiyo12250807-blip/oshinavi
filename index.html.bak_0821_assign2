    const uniqTicketUrls = [...new Set((ev.tickets || []).map(t => t.url).filter(Boolean))];
    const multiTicketUrl = uniqTicketUrls.length > 1;
    const VENDOR_TICKET_KEYS = ["rakuten", "pia", "eplus", "lawson", "fany", "yoshimoto", "tvasahi", "shochiku", "official"];
    const linksHTML = linkDefs
      .filter(d => ev.links && ev.links[d.key])
      .filter(d => !(hasPrimaryVendor && (d.key === "eplus" || d.key === "lawson")))
      .filter(d => !(multiTicketUrl && VENDOR_TICKET_KEYS.includes(d.key)))
      .map(d => {
        const label = (d.key === "amazonGoods" && ev.links.amazonGoodsLabel) ? ev.links.amazonGoodsLabel : d.label;
        return `<a class="ticket-link-btn ${d.cls}" href="${ev.links[d.key]}" target="_blank" rel="noopener">${d.icon} ${label}</a>`;
